     "output_type": "display_data"
    }
   ],
   "source": [
    "# Visualize the distribution of classes\n",
    "plt.figure(figsize=(3,3))\n",
    "plt.scatter(X.iloc[:, 0], X.iloc[:, 1], c=y)\n",
    "plt.xlabel('Clump Thickness')\n",
    "plt.ylabel('Uniformity of Cell Size')\n",
    "plt.title('Visualization of Breast Cancer Data')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "895f6e68-5d69-4898-b1e3-bc4a6f5db15c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define numerical features (all features are numerical)\n",
    "numerical_features = X_train.columns.tolist()\n",
    "\n",
    "# Define the preprocessing steps for numerical features\n",
    "numerical_transformer = Pipeline(steps=[\n",
    "    ('scaler', StandardScaler())\n",
    "])\n",
    "\n",
    "# Combine preprocessing steps into a column transformer\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('num', numerical_transformer, numerical_features)\n",
    "    ])\n",
    "\n",
    "# Define the SVC model pipeline\n",
    "svc_pipeline = Pipeline(steps=[\n",
    "    ('preprocessor', preprocessor),\n",
    "    ('svc', SVC())\n",
    "])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "4050b7cf-ef5a-44f4-9822-76702d8fb453",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best parameters found:  {'svc__C': 1, 'svc__coef0': 1, 'svc__degree': 2, 'svc__kernel': 'poly'}\n",
      "Best cross-validation accuracy: 0.97\n"
     ]
    }
   ],
   "source": [
    "# Define the parameter grid for GridSearchCV\n",
    "param_grid = [\n",
    "    {'svc__kernel': ['linear'], 'svc__C': [0.001, 0.1, 1, 10, 100]},\n",
    "    {'svc__kernel': ['poly'], 'svc__C': [0.001, 0.1, 1, 10, 100], 'svc__degree': [2, 3, 4], 'svc__coef0': [0, 1, 10]},\n",
    "    {'svc__kernel': ['rbf'], 'svc__C': [0.001, 0.01, 0.1, 1, 10, 100], 'svc__gamma': [0.001, 0.01, 0.1, 1, 10, 100]}\n",
    "]\n",
    "\n",
    "# Perform GridSearchCV\n",
    "grid_search = GridSearchCV(svc_pipeline, param_grid, cv=5, scoring='accuracy', return_train_score=True)\n",
    "grid_search.fit(X_train, y_train)\n",
    "\n",
    "# Print the best parameters and best score\n",
    "print(\"Best parameters found: \", grid_search.best_params_)\n",
    "print(\"Best cross-validation accuracy: {:.2f}\".format(grid_search.best_score_))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "91bd091e-f245-4f05-bb1f-25dc24e2a2ca",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Test set accuracy of the best model: 0.97\n"
     ]
    }
   ],
   "source": [
    "# Evaluate the best model on the test set\n",
    "best_model = grid_search.best_estimator_\n",
    "test_accuracy = best_model.score(X_test, y_test)\n",
    "print(\"Test set accuracy of the best model: {:.2f}\".format(test_accuracy))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "1e7b32f8-e609-4992-8fe3-cd4ebf3ded6b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Use only the first two features for visualization\n",
    "X_train_2d = X_train.iloc[:, :2].values\n",
    "X_test_2d = X_test.iloc[:, :2].values\n",
    "\n",
    "# Fit models on the first two features\n",
    "lsvc_2d = SVC(kernel='linear', C=1000).fit(X_train_2d, y_train)\n",
    "svc_rbf_2d = SVC(kernel='rbf', gamma=1, C=2).fit(X_train_2d, y_train)\n",
    "svc_poly_2d = SVC(kernel='poly', degree=3, coef0=2).fit(X_train_2d, y_train)\n",
    "\n",
    "models_2d = [lsvc_2d, svc_rbf_2d, svc_poly_2d]\n",
    "titles = ['Linear kernel', 'RBF kernel', 'Polynomial kernel']\n"
   ]
  },
